# Neon Postgres — pooled connection string (app runtime)
DATABASE_URL=
# Neon Postgres — direct connection string (used only for `prisma migrate`)
DIRECT_URL=

# Random 32+ byte secret used to sign admin session JWTs, e.g. `openssl rand -base64 32`
SESSION_SECRET=

# Admin login credentials
ADMIN_EMAIL=
# bcrypt hash of the admin password (generate with bcryptjs.hashSync).
# IMPORTANT: bcrypt hashes contain `$` and Next.js auto-expands `$VAR` references
# in .env files — escape every `$` as `\$` or the hash will be silently corrupted.
ADMIN_PASSWORD_HASH=

# Resend — https://resend.com
RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAIL=faizanhashmi603@gmail.com
