# Neon Postgres — pooled connection string (app runtime)
DATABASE_URL=
# Neon Postgres — direct connection string (used only for `prisma migrate`)
DIRECT_URL=

# Random 32+ byte secret used to sign admin session JWTs, e.g. `openssl rand -base64 32`
SESSION_SECRET=

# Admin login credentials
ADMIN_EMAIL=
# bcrypt hash of the admin password (generate with bcryptjs.hashSync).
# IMPORTANT: bcrypt hashes contain `$` and Next.js auto-expands `$VAR` references
# in .env files — escape every `$` as `\$` or the hash will be silently corrupted.
ADMIN_PASSWORD_HASH=

# Hostinger mailbox SMTP — sends booking + customer confirmation emails
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=services@moroccovisaservice.com
SMTP_PASS=
# Inbox that receives every booking
ADMIN_NOTIFICATION_EMAIL=services@moroccovisaservice.com

# Public site URL used for Stripe return links and emails (http://localhost:3000 in dev)
SITE_URL=https://moroccovisaservice.com

# Stripe — https://dashboard.stripe.com/apikeys (use sk_test_... until you go live)
STRIPE_SECRET_KEY=
# Webhook signing secret. Endpoint: {SITE_URL}/api/stripe/webhook
# Events: checkout.session.completed, checkout.session.async_payment_succeeded, charge.refunded
# Local dev: `stripe listen --forward-to localhost:3000/api/stripe/webhook` prints a whsec_... value
STRIPE_WEBHOOK_SECRET=

# Where passport scans/photos are stored. MUST be outside the repo/public folder and persist across deploys,
# e.g. /var/lib/morocco-uploads (back it up). Defaults to ./private-uploads.
UPLOAD_DIR=
